# --- required ---
TINYFISH_API_KEY=
# The one password for signing in (8+ characters). Use a long random one in production.
APP_PASSWORD=
# Signs session cookies. Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- optional ---
# Local http only: allow the session cookie without HTTPS. Never set this in production.
# COOKIE_SECURE=0
# Credential vault (1Password / Bitwarden) for login-only portals. Off unless set to 1.
# ENABLE_VAULT=0
# SESSION_DAYS=7
# MAX_CONCURRENT_AGENT_RUNS=3
# MAX_SOURCES=100
# Where the SQLite database lives (point this at a persistent volume in production).
# DB_PATH=/data/jobfish.db
# Render free plan: ping our own public URL every KEEP_ALIVE_MINUTES so the instance doesn't sleep.
# KEEP_ALIVE=0
# KEEP_ALIVE_MINUTES=10
# KEEP_ALIVE_URL=https://your-app.onrender.com   (defaults to Render's RENDER_EXTERNAL_URL)
# Expose interactive API docs at /api/docs (signed-in only).
# ENABLE_DOCS=0
